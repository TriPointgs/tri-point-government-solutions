{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    },
    "api/shop.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tripointgs.com"
        }
      ],
      "destination": "https://tripointgs.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/shop-preview",
      "destination": "/api/shop?view=page"
    },
    {
      "source": "/admin/catalog",
      "destination": "/api/catalog?view=page"
    },
    {
      "source": "/admin/orders",
      "destination": "/api/commerce?view=page"
    },
    {
      "source": "/admin/inquiries",
      "destination": "/api/contact?view=admin-page"
    },
    {
      "source": "/admin/products",
      "destination": "/api/product-controls?view=page"
    },
    {
      "source": "/learn/:path*",
      "destination": "/api/retired"
    },
    {
      "source": "/government-contracts/:path*",
      "destination": "/api/retired"
    },
    {
      "source": "/solutions/zoom",
      "destination": "/api/zoom-page?view=marketing"
    },
    {
      "source": "/solutions/zoom/quote",
      "destination": "/api/zoom-page?view=quote"
    },
    {
      "source": "/contractors/admin/zoom",
      "destination": "/api/zoom-page?view=admin"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/contractors/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/contractors/thanks",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/contractors/admin/opportunities",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/contractors/admin/zoom",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin/catalog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/catalog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/zoom-sales?job=reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
